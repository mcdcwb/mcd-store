# Configuração ilustrativa. Crie um PostgreSQL local exclusivo antes de habilitar
# comandos de banco; não use URLs nem credenciais do ambiente original.
DATABASE_URL="postgresql://demo:demo@127.0.0.1:5432/mcd_store_demo?schema=public"
# Gere 32 bytes aleatórios em hexadecimal conforme o README. Não use um segredo padrão.
JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

DEMO_MODE=true

# Administrador inicial para npm run seed:admin (não versione valores reais).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Modo demonstração do painel: "true" deixa o cliente logado (USER) ver o /manager em modo
# leitura (escritas recebem 403 { demo: true }). Ausente ou "false": painel só para ADMIN.
PANEL_READ_ONLY_FOR_USERS=true
